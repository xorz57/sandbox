---
Checks:
  - clang-diagnostic-*
  - clang-analyzer-*
  - bugprone-*
  - performance-*
  - readability-*
  - modernize-*
  - cppcoreguidelines-*
  - misc-include-cleaner
  - -modernize-use-trailing-return-type
  - -cppcoreguidelines-avoid-magic-numbers
  - -readability-identifier-length
  - -readability-magic-numbers
WarningsAsErrors: '*'
HeaderFilterRegex: '.*'
ExcludeHeaderFilterRegex: ''
FormatStyle:     file
SystemHeaders:   false
CheckOptions:
  misc-include-cleaner.IgnoreHeaders: 'glm/.*'
...

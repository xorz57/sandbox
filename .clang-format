---
BasedOnStyle: LLVM
Language: Cpp
ColumnLimit: 120
BreakTemplateDeclarations: Yes
PackConstructorInitializers: Never
IncludeBlocks: Regroup
IncludeCategories:
  - Regex: '^<(([[:alnum:]_]+/)*[[:alnum:]_]+\.h)'
    Priority: 1
  - Regex: '^<([[:alnum:]_]+)>$'
    Priority: 2
  - Regex: '^<(([[:alnum:]_]+/)*[[:alnum:]_]+)\.(h|hpp)>'
    Priority: 3
  - Regex: '^"(([[:alnum:]_]+/)*[[:alnum:]_]+)\.(h|hpp)"'
    Priority: 4
...

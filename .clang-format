---
BasedOnStyle: LLVM
Language: Cpp
ColumnLimit: 120
IndentWidth: 4
AccessModifierOffset: -4
ContinuationIndentWidth: 4
TabWidth: 4
AlwaysBreakTemplateDeclarations: Yes
BinPackParameters: OnePerLine
BinPackArguments: false
IncludeBlocks: Regroup
IncludeCategories:
  - Regex: '^"'
    Priority: 1
  - Regex: '\.(h|hpp)>$'
    Priority: 2
  - Regex: '^<'
    Priority: 3
...

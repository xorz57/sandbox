---
BasedOnStyle: LLVM
Language: Cpp
ColumnLimit: 120
AlwaysBreakTemplateDeclarations: Yes
BinPackParameters: OnePerLine
BinPackArguments: false
PackConstructorInitializers: Never
IncludeBlocks: Regroup
IncludeCategories:
  - Regex: '^"'
    Priority: 1
  - Regex: '\.(h|hpp)>$'
    Priority: 2
  - Regex: '^<'
    Priority: 3
...
